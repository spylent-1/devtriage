DEEPSEEK_API_KEY=
DEVTRIAGE_BASE_URL=https://api.deepseek.com
DEVTRIAGE_MODEL=deepseek-chat
DEVTRIAGE_DATA_DIR=.devtriage
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional USD / million tokens. Leave unset rather than assume prices.
# DEVTRIAGE_INPUT_PRICE=0
# DEVTRIAGE_OUTPUT_PRICE=0

# RAG: SQLite + BM25 works without an embedding endpoint.
DEVTRIAGE_RAG_ENABLED=true
DEVTRIAGE_RAG_BACKEND=sqlite
# DEVTRIAGE_RAG_DSN=postgresql://devtriage:YOUR_PASSWORD@localhost:15432/devtriage
# Configure a separate OpenAI-compatible /embeddings provider (base ends in /v1).
# DeepSeek chat credentials are NOT implicitly reused for embeddings.
# DEVTRIAGE_EMBEDDING_BASE_URL=http://localhost:8000/v1
# DEVTRIAGE_EMBEDDING_MODEL=your-embedding-model
# DEVTRIAGE_EMBEDDING_API_KEY=your-embedding-key
DEVTRIAGE_RAG_MIN_SIMILARITY=0.55
